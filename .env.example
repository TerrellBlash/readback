# Copy this to .env and fill in your values
# Usage: export $(cat .env | xargs)

# Required: Your LLM API key
OPENAI_API_KEY=sk-your-key-here

# Optional: a different OpenAI model (default gpt-6-luna)
# DOC_AGENT_MODEL=gpt-6-luna

# Optional: LangSmith observability (recommended)
# LANGSMITH_API_KEY=ls-your-key-here
# LANGSMITH_PROJECT=readback
# LANGCHAIN_TRACING_V2=true
