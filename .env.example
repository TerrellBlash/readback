# Copy to .env and fill in. Load it with:  set -a; source .env; set +a
# Every variable is described in the README's Configuration table.

OPENAI_API_KEY=sk-your-key-here

# DOC_AGENT_MODEL=gpt-6-luna
# DOC_AGENT_REASONING_EFFORT=none
# DOC_AGENT_CHECK_MODEL=gpt-6.1-sol     # off to disable the second read
# DOC_AGENT_CHECK_REASONING_EFFORT=low

# Postgres for paused reviews; unset uses in-memory checkpoints.
# DATABASE_URL=postgresql://docagent:docagent@localhost:5433/docagent

# Require an X-API-Key header on every endpoint except /health and the docs.
# DOC_AGENT_API_KEY=
